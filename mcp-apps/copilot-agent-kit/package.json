{
  "name": "agent-review-mcpapp",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Standalone MCP App for reviewing Copilot Studio agents.",
  "scripts": {
    "build": "tsc --noEmit && node build-ui.mjs && tsc -p tsconfig.server.json",
    "start": "node dist/server/main.js",
    "serve": "tsx main.ts",
    "dev": "cross-env NODE_ENV=development concurrently \"node build-ui.mjs --watch\" \"tsx watch main.ts\"",
    "test": "npm run test:node && npm run test:review-core && npm run test:review-ui",
    "test:node": "tsx --test \"src/agent-debugger/**/*.test.ts\" \"src/agent-map/**/*.test.ts\" \"src/agent-review/server/**/*.test.ts\" \"src/evaluation/**/*.test.ts\" \"src/tools/**/*.test.ts\" \"src/widgets/**/*.test.ts\" \"test/**/*.test.ts\"",
    "test:review-core": "vitest run --config test/config/vitest.agent-review-core.config.ts",
    "test:review-ui": "vitest run --config test/config/vitest.agent-review-ui.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "inspector": "npx @modelcontextprotocol/inspector@0.20.0 http://localhost:3001/mcp",
    "validate:agent": "npx -y --package @microsoft/m365agentstoolkit-cli atk validate --env local"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.72.0",
    "@fluentui/react-datepicker-compat": "^0.6.36",
    "@fluentui/react-icons": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "1.1.2",
    "@modelcontextprotocol/sdk": "1.27.1",
    "@xyflow/react": "12.11.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "js-yaml": "^4.1.1",
    "prismjs": "^1.30.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tabster": "8.8.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.3.19",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.5",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "3.2.4"
  }
}
