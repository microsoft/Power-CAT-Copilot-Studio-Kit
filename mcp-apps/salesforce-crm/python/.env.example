# Salesforce Connected App credentials (OAuth2 client_credentials flow)
SF_INSTANCE_URL=https://your-instance.salesforce.com
SF_CLIENT_ID=your-connected-app-client-id
SF_CLIENT_SECRET=your-connected-app-client-secret

# MCP Server
PORT=8080
CORS_ORIGINS=*

# App Insights telemetry (optional — leave blank to disable)
APPINSIGHTS_CONNECTION_STRING=
APPINSIGHTS_ROLE_NAME=lob-mcp-sf
